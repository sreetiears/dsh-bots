{
  "name": "@local/dsh-bots",
  "version": "0.8.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "A Bots panel for DeepSeek Harness: bots, rooms, memory files and routines.",
  "keywords": ["deepseek-harness", "dsh", "plugin", "bundle", "bots", "agents"],
  "repository": { "type": "git", "url": "git+https://github.com/sreetiears/dsh-bots.git" },
  "bugs": { "url": "https://github.com/sreetiears/dsh-bots/issues" },
  "homepage": "https://github.com/sreetiears/dsh-bots#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": { "node": ">=22" }
}
